name: Prop Hunter Odds Diagnostic

on:
  workflow_dispatch:

jobs:
  odds-diagnostic:
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install requests
        run: |
          python -m pip install --upgrade pip
          pip install requests

      - name: Compile diagnostic
        run: python -m py_compile prop_hunter_odds_diagnostic.py

      - name: Run odds diagnostic
        env:
          ODDS_API_KEY: ${{ secrets.ODDS_API_KEY }}
          ODDS_API_KEYS: ${{ secrets.ODDS_API_KEYS }}
          ODDS_REGIONS: us,eu
        run: python prop_hunter_odds_diagnostic.py

      - name: Upload diagnostic report
        uses: actions/upload-artifact@v4
        with:
          name: prop-hunter-odds-diagnostic-report
          path: prop_hunter_odds_diagnostic_report.json
